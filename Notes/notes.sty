\renewcommand{\bottomfraction}{0.8}     % ... or 80% of the bottom
\renewcommand{\textfraction}{0.07}      % a text page needs only 7% text
\renewcommand{\floatpagefraction}{0.8}  % a floats-only page must be at least 80% full
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
