\usepgfplotslibrary{fillbetween}
\tikzset{
  >={Stealth[length=2.2mm]},
  every picture/.style={line cap=round,line join=round},
  vec/.style={->,thick,tangentgreen},
  form/.style={thick,formblue},
  bdry/.style={very thick,bdryred},
  fibre/.style={thick,fibreorange},
  faint/.style={softgray,thin},
  lbl/.style={font=\small},
