% ---------- boxes ----------
\RequirePackage[most]{tcolorbox}
\tcbset{
  notesbase/.style={enhanced,breakable,sharp corners=south,arc=2mm,
    boxrule=0.4pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,
    fonttitle=\bfseries\sffamily\small,coltitle=black!80,colbacktitle=black!5,
    titlerule=0.3pt,before skip=10pt,after skip=10pt},
}
% Big idea: the one sentence you must remember
\newtcolorbox{keyidea}[1][]{notesbase,colback=ideabg,colframe=black!28,
  title={Key idea\ifx\relax#1\relax\else: #1\fi}}
% Physical / geometric picture
\newtcolorbox{intuition}[1][]{notesbase,colback=intuitbg,colframe=black!28,
  title={Physical picture\ifx\relax#1\relax\else: #1\fi}}
% Operational ("working") definition: how to compute/recognise it
\newcounter{wdef}[chapter]
\renewcommand{\thewdef}{\thechapter.\arabic{wdef}}
\newtcolorbox{workdef}[1][]{notesbase,colback=defbg,colframe=black!28,
  step=wdef,before upper app={\makeatletter\def\@currentlabel{\thewdef}\def\cref@currentlabel{[wdef][\arabic{wdef}][\arabic{chapter}]\thewdef}\makeatother},title={Working definition~\thewdef\ifx\relax#1\relax\else\ (#1)\fi}}
% Mental picture: sits directly under a working definition and decompresses it
\definecolor{picbg}{HTML}{FBFBFA}
\newtcolorbox{mentalpic}[1][]{notesbase,colback=picbg,colframe=black!28,
  title={Mental picture\ifx\relax#1\relax\else: #1\fi}}
% Solved example
\newcounter{wex}[chapter]
\renewcommand{\thewex}{\thechapter.\arabic{wex}}
\newtcolorbox{example}[1][]{notesbase,colback=exbg,colframe=black!28,
  step=wex,before upper app={\makeatletter\def\@currentlabel{\thewex}\def\cref@currentlabel{[wex][\arabic{wex}][\arabic{chapter}]\thewex}\makeatother},title={Worked example~\thewex\ifx\relax#1\relax\else: #1\fi}}
% Pitfall / common confusion
\newtcolorbox{pitfall}[1][]{notesbase,colback=warnbg,colframe=bdryred!45,
  title={Watch out\ifx\relax#1\relax\else: #1\fi}}
% Map back to Nash: what the book says and where
\newtcolorbox{sourcesays}[1][]{notesbase,colback=nashbg,colframe=black!28,
  title={Reading the source\ifx\relax#1\relax\else\ (#1)\fi}}
% Dictionary math <-> physics
\newtcolorbox{dictionary}[1][]{notesbase,colback=white,colframe=black!28,
  title={Dictionary\ifx\relax#1\relax\else: #1\fi}}
% End-of-section / chapter recap
\newtcolorbox{recap}[1][]{notesbase,colback=recapbg,colframe=black!28,
  title={Recap\ifx\relax#1\relax\else: #1\fi}}
% A "try it yourself" with the answer hidden below
\newtcolorbox{tryit}[1][]{notesbase,colback=white,colframe=black!28,
  title={Try it\ifx\relax#1\relax\else: #1\fi}}

% ---------- robust labels inside breakable boxes ----------
% tcolorbox can drop a \label that sits at the very start of a breakable box when a page
% break falls right there. Inside the boxes we therefore write labels immediately.
\makeatletter
\newcommand{\notes@iwrite}[1]{%
  \begingroup\let\protect\@unexpandable@protect
  \edef\reserved@a{\immediate\write\@auxout{#1}}\reserved@a\endgroup}
\newcommand{\notes@immediatelabel}[1]{%
  \@bsphack
  \notes@iwrite{\string\newlabel{#1}{{\@currentlabel}{\thepage}{}{\@currentHref}{}}}%
  \ifdefined\cref@currentlabel
    \notes@iwrite{\string\newlabel{#1@cref}{{\cref@currentlabel}{[1][\arabic{page}][]\thepage}}}%
  \fi
  \@esphack}
\tcbset{notesbase/.append style={before upper app={\let\label\notes@immediatelabel}}}
\makeatother

% ---------- the labelled-equality convention ----------
% In a chain, write   &\eqby{1} ...   and after the chain explain each label
% in an  \begin{explain} ... \end{explain}  list (items auto-numbered (1),(2),...).
\newcommand{\eqby}[1]{\overset{\mathclap{\text{\scriptsize\color{accent}(#1)}}}{=}}
\newcommand{\relby}[2]{\overset{\mathclap{\text{\scriptsize\color{accent}(#1)}}}{#2}}
\newlist{explain}{enumerate}{1}
\setlist[explain]{label={\color{accent}\small(\arabic*)},leftmargin=2.2em,
  itemsep=1pt,topsep=3pt,parsep=0pt}

% inline decompression of a technical term inside a definition: \unpack{what the term means}
\newcommand{\unpack}[1]{{\color{tangentgreen!55!black}\,[\,#1\,]}}
% placeholder for a figure that a separate (Sonnet) figure agent will draw from figspecs/<label>.md
\newcommand{\figtodo}[1]{\fbox{\parbox{0.8\linewidth}{\centering\small\itshape Figure to be drawn: #1}}}
