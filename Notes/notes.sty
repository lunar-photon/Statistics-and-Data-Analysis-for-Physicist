\definecolor{accent}{HTML}{1F4E79}      % headings, labels
\definecolor{formblue}{HTML}{2E6FBF}    % differential forms, fields
\definecolor{bdryred}{HTML}{C0392B}     % boundaries, obstructions
\definecolor{tangentgreen}{HTML}{1E8449}% vectors, tangent things
\definecolor{fibreorange}{HTML}{D35400} % fibres, bundles, sections
\definecolor{softgray}{HTML}{7F8C8D}
\definecolor{ideabg}{HTML}{FBFBFA}
\definecolor{intuitbg}{HTML}{FBFBFA}
\definecolor{defbg}{HTML}{FBFBFA}
