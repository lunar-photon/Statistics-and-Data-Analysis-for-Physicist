% ============================================================
%  Statistics & Data Analysis additions (house style of
%  bayes_theorem_notes.pdf: every idea opens with a story,
%  states the question in words, then does the maths)
% ============================================================
\definecolor{storybg}{HTML}{FBFBFA}
\definecolor{reasonbg}{HTML}{FBFBFA}
\definecolor{takebg}{HTML}{FBFBFA}
\definecolor{codebg}{HTML}{F8F8F6}
% Story: the concrete situation that makes the idea necessary (opens every section)
\newtcolorbox{story}[1][]{notesbase,colback=storybg,colframe=black!28,
  title={Story\ifx\relax#1\relax\else: #1\fi}}
% The central framing: what question this chapter/section answers
\newtcolorbox{framing}[1][]{notesbase,colback=ideabg,colframe=black!28,
  title={The central framing\ifx\relax#1\relax\else: #1\fi}}
% The reasoning: the question stated in words before any symbol (numbered steps welcome)
\newtcolorbox{reasoning}[1][]{notesbase,colback=reasonbg,colframe=black!28,
  title={The reasoning\ifx\relax#1\relax\else: #1\fi}}
% Takeaway: what the example/computation taught us, in one or two sentences
\newtcolorbox{takeaway}[1][]{notesbase,colback=takebg,colframe=black!28,
  title={Takeaway\ifx\relax#1\relax\else: #1\fi}}
% Taxonomy: which tool answers which question, when it applies
\newtcolorbox{taxonomy}[1][]{notesbase,colback=white,colframe=black!28,
  left=7pt,right=7pt,bottom=6pt,
  float=htbp,   % a table cannot split, so the box floats like a figure instead of leaving a gap
  title={Taxonomy\ifx\relax#1\relax\else: #1\fi}}
% Verify vs research: a Monte Carlo / numerical result used to CHECK theory,
% versus used as the actual research instrument
\newtcolorbox{inpractice}[1][]{notesbase,colback=nashbg,colframe=black!28,
  title={How this is used in real research\ifx\relax#1\relax\else: #1\fi}}
% backwards-compatible alias used in the exemplar
\newenvironment{nashsays}[1][]{\begin{sourcesays}[#1]}{\end{sourcesays}}

