% ---------- figures ----------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,decorations.markings,
  decorations.pathmorphing,decorations.pathreplacing,patterns,shapes.geometric,
  shapes.misc,3d,intersections,fit,backgrounds,shadings,matrix,angles,quotes}
