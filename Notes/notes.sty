\numberwithin{equation}{chapter}
\setlength{\parskip}{0.35em}
\allowdisplaybreaks[3]
\raggedbottom   % never stretch vertical space to fill a page
% ---------- float placement (owner: no figure-only pages when the figure fits with text) ----------
